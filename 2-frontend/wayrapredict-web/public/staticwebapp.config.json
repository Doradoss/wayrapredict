{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/*.{css,js,svg,ico,png,jpg,woff,woff2,txt,json,map}"]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Frame-Options": "DENY"
  },
  "mimeTypes": {
    ".json": "application/json"
  }
}
